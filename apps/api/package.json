{
  "name": "api",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "db:push": "dotenv -e .dev.vars -- drizzle-kit push",
    "db:studio": "dotenv -e .dev.vars -- drizzle-kit studio",
    "db:seed": "dotenv -e .dev.vars -- tsx src/db/seed.ts",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.6",
    "@neondatabase/serverless": "^1.0.2",
    "@repo/auth": "workspace:*",
    "@repo/db": "workspace:*",
    "better-auth": "^1.5.6",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.12.9",
    "nanoid": "^5.1.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260317.1",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.21.0",
    "wrangler": "^4.4.0"
  }
}
