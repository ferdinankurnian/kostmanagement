{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "api",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-25",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "api.kost.iydheko.site",
      "custom_domain": true
    },
    {
      "pattern": "cdn.kost.iydheko.site",
      "custom_domain": true
    }
  ],
  "vars": {
    "BETTER_AUTH_URL": "https://api.kost.iydheko.site",
    "CORS_ORIGINS": "https://kost.iydheko.site, http://localhost:3000, http://localhost:5173"
  },
  "triggers": {
    "crons": ["0 0 1 * *"]
  },
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "kost-bucket"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ONBOARDING_DO",
        "class_name": "OnboardingDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["OnboardingDO"]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
